# Copy to .env.local and fill in from your Supabase project settings
# (Project Settings -> API). Only the URL and the anon key belong in this app;
# every query runs as the logged-in user through RLS.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-anon-public-key

# --- Used ONLY by scripts/backup.ts and scripts/restore.ts, run manually from
# --- your own machine. Never referenced by the app, never shipped to the client.
# --- The service role key bypasses RLS, so keep it out of .env.local if you can
# --- and instead export it in the shell before running a backup.
SUPABASE_SERVICE_ROLE_KEY=
# Where backups are written / restored from. Keep it OUTSIDE the repo.
BACKUP_DIR=../sourcing-catalog-backups
